{
  "manifest_version": 3,
  "name": "Benchsale Dan — Dice Helper",
  "version": "2.0.0",
  "description": "Sign in to Benchsale Dan, pick a person, and apply to matching Dice Easy Apply jobs with their saved answers. Results go to your Benchsale Dan report.",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://www.dice.com/*",
    "https://dice.com/*",
    "https://*.dice.com/*",
    "https://benchsaledan.com/*",
    "https://www.benchsaledan.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dice Helper",
    "default_icon": { "16": "icon16.png", "48": "icon48.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://www.dice.com/*", "https://dice.com/*", "https://*.dice.com/*"],
      "js": ["filler.js", "auto.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
