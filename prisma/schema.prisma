// Multi-Domain Resume Builder — relational data model (spec §12).
// Candidate evidence, generic templates and immutable resume versions are kept separate.

generator client {
  provider      = "prisma-client-js"
  // "native" plus the Linux variants used by common hosts (Hostinger uses CloudLinux / RHEL-family servers).
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

// MySQL / MariaDB (e.g. Hostinger databases). Lists are stored as JSON arrays because MySQL has
// no array columns; long text uses TEXT types.
datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL") // only used by `prisma migrate dev` during development
}

enum UserRole {
  ADMIN
  CREATOR
  REVIEWER
  READONLY
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum VerificationStatus {
  UNVERIFIED
  CANDIDATE_CONFIRMED
  VERIFIED
}

enum ResumeStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  EXPORTED
}

enum ProjectMode {
  FULL_DETAIL
  STANDARD
  CONCISE
}

enum BulletType {
  DOMAIN
  PROJECT
  SUPPORTING_TOOL
  QA
}

enum ApprovalState {
  PROPOSED
  ACCEPTED
  REJECTED
}

enum RequirementCategory {
  MUST_HAVE
  PREFERRED
  DOMAIN
  RESPONSIBILITY
  QUALIFICATION
  METHODOLOGY
}

enum MatchState {
  SUPPORTED
  PARTIAL
  MISSING
  NEEDS_CONFIRMATION
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ProcessingStatus {
  PENDING
  EXTRACTED
  ANALYZED
  FAILED
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash   String
  role           UserRole     @default(CREATOR)
  status         UserStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  candidates     Candidate[]  @relation("CandidateOwner")
  resumeVersions ResumeVersion[]
  jobDescriptions JobDescription[]
  applications   JobApplication[]
  auditEvents    AuditEvent[]
}

model Session {
  id        String   @id // sha256 of the opaque token stored in the cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id // sha256 of token
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Domain {
  id          String   @id @default(cuid())
  key         String   @unique // BANKING, RETAIL, HEALTHCARE, PHARMA, PC_INSURANCE
  name        String   @unique
  aliases     Json
  subdomains  Json
  terminology Json
  active      Boolean  @default(true)
  templates   ProjectTemplate[]
  clients     Client[]
}

model JobRole {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String   @unique
  aliases           Json
  skillCategories   Json // conditional Technical Skills categories (§6.4)
  summaryFocus      Json
  includeQaBullets  Boolean  @default(true)
  active            Boolean  @default(true)
  templates         ProjectTemplate[]
}

model ProjectTemplate {
  id                String    @id @default(cuid())
  name              String
  domainId          String
  domain            Domain    @relation(fields: [domainId], references: [id])
  subdomain         String
  roleId            String?
  role              JobRole?  @relation(fields: [roleId], references: [id])
  seniority         String?
  version           Int       @default(1)
  projectPattern    String @db.Text
  requiredInputs    Json
  optionalInputs    Json
  domainBullets     Json
  projectBullets    Json
  supportingBullets Json
  qaBullets         Json
  excludedClaims    Json
  terminology       Json
  suggestedTech     Json
  status            String    @default("ACTIVE")
  lastReviewedAt    DateTime?
  reviewer          String?
  usageCount        Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  projects          Project[]

  @@unique([name, version])
  @@index([domainId])
}

model Technology {
  id            String   @id @default(cuid())
  canonicalName String   @unique
  aliases       Json
  category      String
  roles         Json
  domains       Json
  projectTypes  Json
  availableFrom Int?     // first year generally available, for anachronism warnings
  lifecycle     String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  clientLinks   ClientTechnology[]
  projectLinks  ProjectTechnology[]
  candidateSkills CandidateSkill[]

  @@index([category])
}

model Client {
  id                 String             @id @default(cuid())
  name               String
  normalizedName     String             @unique
  domainId           String
  domain             Domain             @relation(fields: [domainId], references: [id])
  subdomain          String?
  market             String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  evidence           String? @db.Text
  verifiedAt         DateTime?
  isDemo             Boolean            @default(false)
  active             Boolean            @default(true)
  usageCount         Int                @default(0)
  lastUsedAt         DateTime?
  createdAt          DateTime           @default(now())
  technologies       ClientTechnology[]
  usages             ClientUsage[]

  @@index([domainId])
  @@index([name])
}

model ClientTechnology {
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  technologyId String
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  evidence     String? @db.Text
  verifiedAt   DateTime?

  @@id([clientId, technologyId])
}

model ClientUsage {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  resumeId   String
  createdAt  DateTime @default(now())

  @@index([clientId])
}

model Candidate {
  id                 String    @id @default(cuid())
  ownerId            String
  owner              User      @relation("CandidateOwner", fields: [ownerId], references: [id])
  team               String?
  fullName           String
  email              String?
  phone              String?
  location           String?
  linkedin           String?
  targetRole         String?
  targetTitle        String?
  domainKey          String?
  consentObtainedAt  DateTime?
  retentionUntil     DateTime?
  notes              String? @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  employments        Employment[]
  education          Education[]
  certifications     Certification[]
  skills             CandidateSkill[]
  projects           Project[]
  resumes            Resume[]
  applicantProfile   ApplicantProfile?
  applications       JobApplication[]

  @@index([ownerId])
  @@index([domainKey])
  @@index([createdAt])
}

model Employment {
  id          String             @id @default(cuid())
  candidateId String
  candidate   Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employer    String
  location    String?
  title       String
  startDate   DateTime           @db.Date
  endDate     DateTime?          @db.Date // null = current
  engagement  String             @default("FULL_TIME") // FULL_TIME, CONTRACT, PART_TIME
  evidence    String? @db.Text
  status      VerificationStatus @default(CANDIDATE_CONFIRMED)
  projects    Project[]

  @@index([candidateId])
}

model Education {
  id            String             @id @default(cuid())
  candidateId   String
  candidate     Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution   String
  qualification String
  startDate     DateTime?          @db.Date
  endDate       DateTime?          @db.Date
  status        VerificationStatus @default(CANDIDATE_CONFIRMED)
}

model Certification {
  id          String             @id @default(cuid())
  candidateId String
  candidate   Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  issuer      String
  name        String
  issuedAt    DateTime?          @db.Date
  status      VerificationStatus @default(CANDIDATE_CONFIRMED)
}

model CandidateSkill {
  id           String             @id @default(cuid())
  candidateId  String
  candidate    Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  technologyId String
  technology   Technology         @relation(fields: [technologyId], references: [id])
  years        Float?
  proficiency  String?
  source       String             @default("USER_CONFIRMED") // USER_CONFIRMED, RESUME_IMPORT, JD_CONFIRMATION
  status       VerificationStatus @default(CANDIDATE_CONFIRMED)
  createdAt    DateTime           @default(now())

  @@unique([candidateId, technologyId])
}

model Project {
  id                String              @id @default(cuid())
  candidateId       String
  candidate         Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employmentId      String?
  employment        Employment?         @relation(fields: [employmentId], references: [id])
  templateId        String?
  template          ProjectTemplate?    @relation(fields: [templateId], references: [id])
  position          Int                 @default(1)
  title             String
  role              String
  domainKey         String
  subdomain         String?
  description       String? @db.Text
  responsibilities  Json            // candidate-supplied facts
  outcomes          Json
  startDate         DateTime            @db.Date
  endDate           DateTime?           @db.Date
  clientConfirmed   Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  technologies      ProjectTechnology[]
  bullets           ProjectBullet[]

  @@index([candidateId])
  @@index([title])
}

model ProjectTechnology {
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technologyId String
  technology   Technology @relation(fields: [technologyId], references: [id])
  context      String? @db.Text
  evidence     String? @db.Text
  confirmed    Boolean    @default(true)

  @@id([projectId, technologyId])
}

model ProjectBullet {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text          String @db.Text
  type          BulletType
  sourceEvidence String? @db.Text
  approvalState ApprovalState @default(PROPOSED)
  createdAt     DateTime      @default(now())
}

model Resume {
  id          String          @id @default(cuid())
  candidateId String
  candidate   Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title       String
  domainKey   String
  roleKey     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    ResumeVersion[]
  jobs        GenerationJob[]
  exports     ExportFile[]

  @@index([candidateId])
  @@index([domainKey, roleKey])
}

model ResumeVersion {
  id             String       @id @default(cuid())
  resumeId       String
  resume         Resume       @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  version        Int
  templateKey    String       @default("classic")
  pageTarget     Int          @default(4)
  projectMode    ProjectMode  @default(STANDARD)
  content        Json         // immutable snapshot of ResumeContent
  validation     Json?
  status         ResumeStatus @default(DRAFT)
  parentVersionId String?
  changeNote     String? @db.Text
  reviewNote     String? @db.Text
  reviewedById   String?
  reviewedAt     DateTime?
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  matches        ResumeMatch[]
  suggestions    EditSuggestion[]

  @@unique([resumeId, version])
  @@index([status])
  @@index([createdAt])
}

model JobDescription {
  id               String           @id @default(cuid())
  ownerId          String
  owner            User             @relation(fields: [ownerId], references: [id])
  title            String
  sourceFileName   String?
  sourceMime       String?
  extractedText    String @db.LongText
  targetRole       String?
  processingStatus ProcessingStatus @default(EXTRACTED)
  createdAt        DateTime         @default(now())
  requirements     JDRequirement[]

  @@index([ownerId])
}

model JDRequirement {
  id               String              @id @default(cuid())
  jobDescriptionId String
  jobDescription   JobDescription      @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  keyword          String
  canonical        String
  technologyId     String?
  category         RequirementCategory
  weight           Float
  required         Boolean
  sourceLine       String? @db.Text
  matches          ResumeMatch[]

  @@index([jobDescriptionId])
}

model ResumeMatch {
  id               String        @id @default(cuid())
  resumeVersionId  String
  resumeVersion    ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  requirementId    String
  requirement      JDRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  state            MatchState
  evidenceRefs     Json
  explanation      String? @db.Text
  reviewerDecision String?
  userConfirmed    Boolean       @default(false)
  createdAt        DateTime      @default(now())

  @@unique([resumeVersionId, requirementId])
}

model EditSuggestion {
  id               String        @id @default(cuid())
  resumeVersionId  String
  resumeVersion    ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  jobDescriptionId String?
  section          String
  projectRef       String?
  originalText     String? @db.Text
  proposedText     String @db.Text
  jdKeywordRefs    Json
  evidenceRefs     Json
  requiresConfirmation Boolean   @default(false)
  decision         ApprovalState @default(PROPOSED)
  decidedById      String?
  decidedAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([resumeVersionId])
}

model GenerationJob {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique
  kind           String    // NEW_RESUME, TAILOR, EXPORT
  resumeId       String?
  resume         Resume?   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  status         JobStatus @default(QUEUED)
  input          Json
  inputVersion   Int?
  outputVersionId String?
  configVersion  String
  modelName      String?
  inputTokens    Int       @default(0)
  outputTokens   Int       @default(0)
  costUsd        Float     @default(0)
  durationMs     Int?
  attempts       Int       @default(0)
  warnings       Json?
  errorDetails   String? @db.Text
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

model ExportFile {
  id              String   @id @default(cuid())
  resumeId        String
  resume          Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeVersionId String
  format          String   // DOCX | PDF
  fileName        String
  storagePath     String? @db.Text  // legacy on-disk exports
  data            Bytes? @db.LongBlob  // file contents (stored in the database so any host can serve them)
  bytes           Int
  pageCount       Int?
  createdById     String
  createdAt       DateTime @default(now())
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  recordType String
  recordId   String?
  outcome    String   // SUCCESS | DENIED | FAILURE
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([recordType, recordId])
  @@index([actorId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------------------------------------------
// Dice Apply assistant
// ------------------------------------------------------------------------------------------------

/** Saved answers to common application/screening questions, per candidate. */
model ApplicantProfile {
  id          String    @id @default(cuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  baseResumeId String?
  answers     Json      // Record<questionKey, string>
  custom      Json      // [{ question, answer }]
  updatedAt   DateTime  @updatedAt
}

enum ApplicationStatus {
  READY
  OPENED
  APPLIED
  SKIPPED
  NOT_AVAILABLE
}

/** One job the candidate is applying to. The user submits on the job site; the app tracks it. */
model JobApplication {
  id               String            @id @default(cuid())
  ownerId          String
  owner            User              @relation(fields: [ownerId], references: [id])
  candidateId      String
  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobKey           String            // Dice job id, or a hash of the URL
  jobUrl           String            @db.VarChar(1000)
  source           String            @default("DICE")
  title            String?           @db.VarChar(300)
  company          String?           @db.VarChar(300)
  location         String?           @db.VarChar(300)
  jobDescriptionId String?
  coverage         Int?
  status           ApplicationStatus @default(READY)
  notes            String?           @db.Text
  fetchError       String?           @db.VarChar(500)
  openedAt         DateTime?
  appliedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([candidateId, jobKey])
  @@index([ownerId, status])
  @@index([appliedAt])
}
