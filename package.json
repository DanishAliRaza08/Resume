{
  "name": "multi-domain-resume-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-domain resume builder and ATS optimization platform (Banking, Retail, Healthcare, Pharma, P&C Insurance).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://resume:resume@localhost:5432/resume_builder_test?schema=public} vitest run tests/integration.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/client": "^6.19.3",
    "docx": "^9.5.1",
    "mammoth": "^1.10.0",
    "next": "^15.5.27",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
