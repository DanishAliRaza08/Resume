{
  "name": "benchsale-dan",
  "version": "0.1.0",
  "private": true,
  "description": "Benchsale Dan \u2014 multi-domain resume builder, JD tailoring and Dice Apply assistant. Developed by Danish Ali Raza.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/gen-migrations.mjs && prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-mysql://resume:resume@localhost:3306/resume_builder_test} vitest run tests/integration.test.ts",
    "start:prod": "npm start",
    "postinstall": "prisma generate",
    "start:next": "next start"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/client": "^6.19.3",
    "docx": "^9.5.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.10.0",
    "next": "^15.5.28",
    "nodemailer": "^10.1.7",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "^8.5.30"
  },
  "author": "Danish Ali Raza"
}
