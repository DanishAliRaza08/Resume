# PostgreSQL connection (required)
DATABASE_URL="postgresql://resume:resume@localhost:5432/resume_builder?schema=public"

# Private directory for generated exports (never served statically)
STORAGE_DIR="./storage"

# Password given to the seeded demo accounts (change before sharing an environment)
SEED_PASSWORD="ChangeMe-2026!"

# Optional AI wording layer. Without a key the deterministic generator is used.
# ANTHROPIC_API_KEY=""
# AI_MODEL="claude-opus-5-5"

# Optional: LibreOffice binary used to measure the rendered page count of DOCX exports
# SOFFICE_PATH="soffice"
