# --- Required -------------------------------------------------------------------------------
# PostgreSQL connection string (managed Postgres such as Neon, Supabase, RDS, Railway or Render works)
DATABASE_URL="postgresql://resume:resume@localhost:5432/resume_builder?schema=public"
# Public address of the site, used in password-reset emails
APP_URL="http://localhost:3000"

# --- Strongly recommended -------------------------------------------------------------------
# Your administrator email. Signing up with this address (or setting ADMIN_PASSWORD, which
# creates the account on start-up) gives administrator access. Everyone else gets a normal account.
ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="a-long-unique-password-123"
# Email delivery for password resets, e.g. smtps://user:pass@smtp.example.com:465
# SMTP_URL=""
# MAIL_FROM="Resume Builder <no-reply@example.com>"

# --- Optional -------------------------------------------------------------------------------
# AI wording polish (otherwise the built-in generator is used)
# ANTHROPIC_API_KEY=""
# AI_MODEL="claude-opus-5-5"
# LibreOffice binary for exact Word page counts
# SOFFICE_PATH="soffice"

# Development only: create demo accounts with a shared known password. NEVER on a public site.
# SEED_DEMO="true"
# SEED_PASSWORD="ChangeMe-2026!"
